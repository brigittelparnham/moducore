# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://moducore:moducore@localhost:5432/moducore

# Secret used for session signing (any random string, keep private)
AUTH_SECRET=replace-with-a-random-secret

# AES-256-GCM encryption key for secrets stored in the DB (connector configs, Starling tokens)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-encoded-32-bytes

# Email sending via Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=moducore <noreply@yourdomain.com>

# Secret token for the iPhone Shortcuts health ingest webhook
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
HABITS_HEALTH_SECRET=replace-with-random-hex

# Secret token for the OwnTracks location ingest webhook
LOCATION_INGEST_SECRET=replace-with-random-hex

# ─── Optional ─────────────────────────────────────────────────────────────────

# TfL Unified API key (free at https://api-portal.tfl.gov.uk)
# Omit to use the API without a key (rate limited but works for dev)
# TFL_APP_KEY=your_tfl_key

# App URLs (defaults to localhost ports for local dev)
# CMS_URL=http://localhost:3001
# JOURNAL_URL=http://localhost:3002
# SPOTIFY_APP_URL=http://localhost:3003
# MAPS_APP_URL=http://localhost:3004
# HABITS_APP_URL=http://localhost:3005
